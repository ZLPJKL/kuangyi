<Window x:Class="KuangYi.App.Windows.DisclaimerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="框译 · 免责声明"
        Width="560"
        Height="620"
        MinHeight="460"
        MaxHeight="720"
        SizeToContent="Manual"
        WindowStyle="None"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterScreen"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display">
    <Border Margin="16"
            Background="{DynamicResource CardBg}"
            BorderBrush="{DynamicResource Border}"
            BorderThickness="1"
            CornerRadius="12">
        <Border.Effect>
            <DropShadowEffect BlurRadius="22" ShadowDepth="2" Opacity="0.28" Color="Black" />
        </Border.Effect>
        <Grid Margin="24,20,24,18">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock Text="免责声明" Style="{StaticResource SectionTitle}" />

            <ScrollViewer Grid.Row="1"
                          Margin="0,12,0,0"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <TextBlock x:Name="BodyText"
                           TextWrapping="Wrap"
                           LineHeight="21"
                           FontSize="13"
                           Foreground="{DynamicResource TextPrimary}" />
            </ScrollViewer>

            <Grid Grid.Row="2" Margin="0,16,0,0">
                <TextBlock Text="点击“我已知悉”后继续使用框译"
                           Style="{StaticResource CaptionText}"
                           VerticalAlignment="Center" />
                <Button Content="我已知悉"
                        Style="{StaticResource PrimaryButton}"
                        Padding="22,8"
                        HorizontalAlignment="Right"
                        Click="Accept_Click" />
            </Grid>
        </Grid>
    </Border>
</Window>
