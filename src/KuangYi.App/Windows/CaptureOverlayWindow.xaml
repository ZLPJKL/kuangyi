<Window x:Class="KuangYi.App.Windows.CaptureOverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="框译 · 框选"
        WindowStyle="None"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStartupLocation="Manual"
        Topmost="True"
        Background="Black"
        Cursor="Cross"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">

    <Grid x:Name="RootGrid" ClipToBounds="True">
        <Image x:Name="ScreenImage" Stretch="Fill" />

        <Canvas x:Name="Layer" IsHitTestVisible="False">
            <Rectangle x:Name="DimTop" Fill="#A6000000" />
            <Rectangle x:Name="DimBottom" Fill="#A6000000" />
            <Rectangle x:Name="DimLeft" Fill="#A6000000" />
            <Rectangle x:Name="DimRight" Fill="#A6000000" />
            <Rectangle x:Name="SelectionBorder"
                       Stroke="{DynamicResource Accent}"
                       StrokeThickness="1.5"
                       Visibility="Collapsed" />
            <Border x:Name="SizeBadge"
                    Background="{DynamicResource CardBg}"
                    BorderBrush="{DynamicResource Border}"
                    BorderThickness="1"
                    CornerRadius="6"
                    Padding="8,3"
                    Visibility="Collapsed">
                <TextBlock x:Name="SizeText" FontSize="11" />
            </Border>
        </Canvas>

        <Border x:Name="HintBadge"
                Background="{DynamicResource CardBg}"
                BorderBrush="{DynamicResource Border}"
                BorderThickness="1"
                CornerRadius="18"
                Padding="16,8"
                HorizontalAlignment="Center"
                VerticalAlignment="Bottom"
                Margin="0,0,0,48"
                Opacity="0.94">
            <TextBlock Text="拖动选择区域，松开开始识别 · Esc 取消"
                       Foreground="{DynamicResource TextSecondary}"
                       FontSize="12" />
        </Border>
    </Grid>
</Window>
