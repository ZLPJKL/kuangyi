<Window x:Class="KuangYi.App.Windows.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="框译"
        Icon="/Assets/app.ico"
        Width="380"
        SizeToContent="Height"
        WindowStyle="None"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterScreen"
        AllowsTransparency="True"
        Background="Transparent"
        UseLayoutRounding="True">
    <Border Margin="14"
            Background="{DynamicResource CardBg}"
            BorderBrush="{DynamicResource Border}"
            BorderThickness="1"
            CornerRadius="12">
        <Border.Effect>
            <DropShadowEffect BlurRadius="20" ShadowDepth="2" Opacity="0.25" Color="Black" />
        </Border.Effect>
        <Grid Margin="20,14,20,16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="0,0,0,8" MouseLeftButtonDown="Header_MouseLeftButtonDown">
                <TextBlock Text="框译" Style="{StaticResource SectionTitle}" VerticalAlignment="Center" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="—"
                            Style="{StaticResource GhostButton}"
                            Padding="10,1"
                            ToolTip="最小化到托盘"
                            Click="Minimize_Click" />
                    <Button Content="✕"
                            Style="{StaticResource GhostButton}"
                            Padding="10,1"
                            ToolTip="退出框译"
                            Click="Close_Click" />
                </StackPanel>
            </Grid>

            <TextBlock Grid.Row="1"
                       Text="按 F2 框选屏幕区域，或点击下方按钮。"
                       Foreground="{DynamicResource TextSecondary}"
                       TextWrapping="Wrap" />

            <Button Grid.Row="2"
                    Content="框选翻译 (F2)"
                    Style="{StaticResource PrimaryButton}"
                    Padding="18,10"
                    Margin="0,16,0,0"
                    Click="Capture_Click" />

            <Grid Grid.Row="3" Margin="0,10,0,0">
                <StackPanel Orientation="Horizontal">
                    <Button Content="设置" Style="{StaticResource GhostButton}" Click="Settings_Click" />
                    <Button Content="结果" Style="{StaticResource GhostButton}" Click="Result_Click" />
                    <Button Content="历史" Style="{StaticResource GhostButton}" Click="History_Click" />
                </StackPanel>
                <Button Content="退出"
                        Style="{StaticResource GhostButton}"
                        Foreground="{DynamicResource Danger}"
                        HorizontalAlignment="Right"
                        Click="Exit_Click" />
            </Grid>
        </Grid>
    </Border>
</Window>
