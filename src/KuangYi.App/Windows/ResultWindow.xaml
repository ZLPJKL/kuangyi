<Window x:Class="KuangYi.App.Windows.ResultWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="框译"
        Icon="/Assets/app.ico"
        Width="470"
        SizeToContent="Height"
        MaxHeight="700"
        WindowStyle="None"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStartupLocation="Manual"
        Topmost="False"
        AllowsTransparency="True"
        Background="Transparent"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display">

    <Border x:Name="CardBorder"
            Margin="14"
            Background="{DynamicResource CardBg}"
            BorderBrush="{DynamicResource Border}"
            BorderThickness="1"
            CornerRadius="12"
            MouseLeftButtonDown="Header_MouseLeftButtonDown">
        <Border.Effect>
            <DropShadowEffect BlurRadius="20" ShadowDepth="2" Opacity="0.25" Color="Black" />
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="14,10,8,4" Background="Transparent" Cursor="SizeAll"
                  ToolTip="按住这里拖动窗口" MouseLeftButtonDown="Header_MouseLeftButtonDown">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <ComboBox x:Name="SourceLangCombo"
                              Width="98"
                              DisplayMemberPath="NameZh"
                              SelectionChanged="SourceLanguage_SelectionChanged" />
                    <TextBlock Text="→" Margin="6,0" VerticalAlignment="Center" Foreground="{DynamicResource TextSecondary}" />
                    <ComboBox x:Name="TargetLangCombo"
                              Width="98"
                              DisplayMemberPath="NameZh"
                              SelectionChanged="TargetLanguage_SelectionChanged" />
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal">
                    <Button x:Name="PinButton"
                            Content="置顶"
                            Style="{StaticResource GhostButton}"
                            ToolTip="固定显示在其他窗口上方（默认关闭）"
                            Click="Pin_Click" />
                    <Button Content="设置"
                            Style="{StaticResource GhostButton}"
                            Click="Settings_Click" />
                    <Button Content="—"
                            Style="{StaticResource GhostButton}"
                            ToolTip="最小化到托盘"
                            Click="Minimize_Click" />
                    <Button Content="✕"
                            Style="{StaticResource GhostButton}"
                            Click="Close_Click" />
                </StackPanel>
            </Grid>

            <TextBox x:Name="SourceBox"
                     Grid.Row="1"
                     Margin="16,2,16,0"
                     MinHeight="54"
                     MaxHeight="150"
                     AcceptsReturn="True"
                     TextWrapping="Wrap"
                     VerticalScrollBarVisibility="Auto"
                     VerticalContentAlignment="Top" />

            <Grid Grid.Row="2" Margin="16,8,16,6">
                <TextBlock x:Name="SourceHint"
                           Text="识别原文，可直接修改后重译"
                           Style="{StaticResource CaptionText}"
                           VerticalAlignment="Center" />
                <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                    <Button Content="复制原文"
                            Style="{StaticResource GhostButton}"
                            Click="CopySource_Click" />
                    <Button x:Name="TranslateButton"
                            Content="重译"
                            Style="{StaticResource GhostButton}"
                            Click="Translate_Click" />
                </StackPanel>
            </Grid>

            <Border Grid.Row="3" Height="1" Background="{DynamicResource Border}" Margin="16,0" />

            <TextBox x:Name="OutputBox"
                     Grid.Row="4"
                     Margin="16,10,16,2"
                     MinHeight="66"
                     MaxHeight="280"
                     IsReadOnly="True"
                     AcceptsReturn="True"
                     TextWrapping="Wrap"
                     VerticalScrollBarVisibility="Auto"
                     Background="Transparent"
                     BorderThickness="0"
                     FontSize="14"
                     Padding="0" />

            <Grid Grid.Row="5" Margin="16,6,16,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border x:Name="ProviderBadge"
                            Background="{DynamicResource BadgeBg}"
                            CornerRadius="4"
                            Padding="6,2"
                            VerticalAlignment="Center"
                            Visibility="Collapsed">
                        <TextBlock x:Name="ProviderText"
                                   FontSize="11"
                                   Foreground="{DynamicResource TextSecondary}" />
                    </Border>
                    <TextBlock x:Name="StatusText"
                               Style="{StaticResource CaptionText}"
                               Margin="8,0,0,0"
                               VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis" />
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="EnableOnlineButton"
                            Content="启用在线翻译"
                            Style="{StaticResource LinkButton}"
                            Visibility="Collapsed"
                            Click="EnableOnline_Click" />
                    <Button Content="复制译文"
                            Style="{StaticResource GhostButton}"
                            Click="CopyTranslation_Click" />
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</Window>
