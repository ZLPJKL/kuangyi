<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Color x:Key="WindowBgColor">#FF000000</Color>
    <Color x:Key="CardBgColor">#FF000000</Color>
    <Color x:Key="TextPrimaryColor">#FFE8E8E8</Color>
    <Color x:Key="TextSecondaryColor">#FF9B9B9B</Color>
    <Color x:Key="BorderColor">#FF2A2A2A</Color>
    <Color x:Key="AccentColor">#FF3B82F6</Color>
    <Color x:Key="AccentTextColor">#FFFFFFFF</Color>
    <Color x:Key="HoverColor">#FF1A1A1A</Color>
    <Color x:Key="InputBgColor">#FF0D0D0D</Color>
    <Color x:Key="DangerColor">#FFFF6B6B</Color>
    <Color x:Key="SelectionBgColor">#FF14213A</Color>
    <Color x:Key="BadgeBgColor">#FF141414</Color>

    <SolidColorBrush x:Key="WindowBg" Color="{StaticResource WindowBgColor}" />
    <SolidColorBrush x:Key="CardBg" Color="{StaticResource CardBgColor}" />
    <SolidColorBrush x:Key="TextPrimary" Color="{StaticResource TextPrimaryColor}" />
    <SolidColorBrush x:Key="TextSecondary" Color="{StaticResource TextSecondaryColor}" />
    <SolidColorBrush x:Key="Border" Color="{StaticResource BorderColor}" />
    <SolidColorBrush x:Key="Accent" Color="{StaticResource AccentColor}" />
    <SolidColorBrush x:Key="AccentText" Color="{StaticResource AccentTextColor}" />
    <SolidColorBrush x:Key="Hover" Color="{StaticResource HoverColor}" />
    <SolidColorBrush x:Key="InputBg" Color="{StaticResource InputBgColor}" />
    <SolidColorBrush x:Key="Danger" Color="{StaticResource DangerColor}" />
    <SolidColorBrush x:Key="SelectionBg" Color="{StaticResource SelectionBgColor}" />
    <SolidColorBrush x:Key="BadgeBg" Color="{StaticResource BadgeBgColor}" />

</ResourceDictionary>
