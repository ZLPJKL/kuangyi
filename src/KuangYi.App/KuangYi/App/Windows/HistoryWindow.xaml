<?xml version="1.0" encoding="utf-8"?>
<Window x:Class="KuangYi.App.Windows.HistoryWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:windows="clr-namespace:KuangYi.App.Windows;assembly=KuangYi" Title="框译 · 历史记录" Icon="/Assets/app.ico" Width="680" Height="600" WindowStyle="None" ResizeMode="NoResize" ShowInTaskbar="False" WindowStartupLocation="CenterScreen" AllowsTransparency="True" Background="#00FFFFFF" UseLayoutRounding="True">
  <Border Margin="14" Background="{DynamicResource CardBg}" BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="12">
    <UIElement.Effect>
      <DropShadowEffect BlurRadius="20" ShadowDepth="2" Opacity="0.25" Color="Black" />
    </UIElement.Effect>
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>
      <Grid Row="0" Margin="20,14,10,4" MouseLeftButtonDown="Header_MouseLeftButtonDown">
        <TextBlock Text="历史记录" Style="{StaticResource SectionTitle}" VerticalAlignment="Center" />
        <Button Content="✕" Style="{StaticResource GhostButton}" HorizontalAlignment="Right" Click="Close_Click" />
      </Grid>
      <Grid Row="1" Margin="16,6,16,8">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <StackPanel Orientation="Horizontal">
          <Button Name="RecentTab" Content="最近" Margin="0,0,6,0" Click="RecentTab_Click" />
          <Button Name="FavoriteTab" Content="收藏" Click="FavoriteTab_Click" />
        </StackPanel>
        <TextBlock Name="CountText" Grid.Column="1" Style="{StaticResource CaptionText}" HorizontalAlignment="Center" VerticalAlignment="Center" />
        <TextBox Name="SearchBox" Grid.Column="2" Width="220" ToolTip="搜索原文或译文" TextChanged="SearchBox_TextChanged" />
      </Grid>
      <Grid Row="2" Margin="16,0,16,0">
        <ListBox Name="EntriesList" SelectionChanged="EntriesList_SelectionChanged" MouseDoubleClick="EntriesList_MouseDoubleClick">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <Grid Margin="10,8">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="64" />
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Border Width="58" Height="40" CornerRadius="4" Background="{DynamicResource InputBg}" ClipToBounds="True" VerticalAlignment="Center">
                  <Image Stretch="UniformToFill" Source="{Binding Thumbnail}" />
                </Border>
                <StackPanel Grid.Column="1" Margin="10,0,10,0" VerticalAlignment="Center">
                  <TextBlock FontSize="13" TextTrimming="CharacterEllipsis" Text="{Binding Title}" />
                  <TextBlock FontSize="12" Foreground="{DynamicResource TextSecondary}" TextTrimming="CharacterEllipsis" Margin="0,2,0,0" Text="{Binding Subtitle}" />
                  <TextBlock FontSize="10" Foreground="{DynamicResource TextSecondary}" Margin="0,3,0,0" Text="{Binding Meta}" />
                </StackPanel>
                <TextBlock Grid.Column="2" Foreground="{DynamicResource Accent}" FontSize="15" VerticalAlignment="Top" Text="{Binding FavoriteMark}" />
              </Grid>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ListBox>
        <TextBlock Name="EmptyText" Text="暂无记录。按 F2 框选并翻译后，这里会出现记录。" Style="{StaticResource CaptionText}" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed" />
      </Grid>
      <Grid Row="3" Margin="16,10,16,14">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <StackPanel Orientation="Horizontal">
          <Button Name="FavoriteButton" Content="收藏" Style="{StaticResource GhostButton}" Click="Favorite_Click" />
          <Button Name="DeleteButton" Content="删除" Style="{StaticResource GhostButton}" Click="Delete_Click" />
          <Button Content="清空最近" Style="{StaticResource GhostButton}" Click="ClearRecent_Click" />
          <Button Content="清空全部" Style="{StaticResource GhostButton}" Click="ClearAll_Click" />
        </StackPanel>
        <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
          <Button Content="导出" Style="{StaticResource GhostButton}" Click="Export_Click" />
          <Button Name="OpenButton" Content="查看" Style="{StaticResource PrimaryButton}" Padding="14,5" Click="Open_Click" />
        </StackPanel>
      </Grid>
    </Grid>
  </Border>
</Window>