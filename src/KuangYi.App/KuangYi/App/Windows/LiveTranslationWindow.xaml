<?xml version="1.0" encoding="utf-8"?>
<Window x:Class="KuangYi.App.Windows.LiveTranslationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="框译 · 实时翻译"
        Icon="/Assets/app.ico"
        Width="560"
        SizeToContent="Height"
        MaxHeight="720"
        WindowStyle="None"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStartupLocation="Manual"
        Topmost="True"
        AllowsTransparency="True"
        Background="#00FFFFFF"
        UseLayoutRounding="True">
    <Border Margin="14"
            Background="{DynamicResource CardBg}"
            BorderBrush="{DynamicResource Border}"
            BorderThickness="1"
            CornerRadius="12"
            MouseLeftButtonDown="Header_MouseLeftButtonDown">
        <UIElement.Effect>
            <DropShadowEffect BlurRadius="20" ShadowDepth="2" Opacity="0.25" Color="Black" />
        </UIElement.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="16,12,10,4">
                <StackPanel>
                    <TextBlock Text="实时翻译" Style="{StaticResource SectionTitle}" FontSize="16" />
                    <TextBlock Text="固定区域每 2.5 秒识别一次" Style="{StaticResource CaptionText}" Margin="0,2,0,0" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Name="PauseButton" Content="暂停" Style="{StaticResource GhostButton}" Click="Pause_Click" />
                    <Button Name="ReselectButton" Content="重选" Style="{StaticResource GhostButton}" Click="Reselect_Click" />
                    <Button Name="PinButton" Content="置顶" Style="{StaticResource GhostButton}" Click="Pin_Click" />
                    <Button Content="✕" Style="{StaticResource GhostButton}" Click="Close_Click" />
                </StackPanel>
            </Grid>

            <Grid Grid.Row="1" Margin="16,4,16,2">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <ComboBox Name="SourceLangCombo" Width="88" DisplayMemberPath="NameZh" SelectionChanged="Language_Changed" />
                    <TextBlock Text="→" Margin="5,0" VerticalAlignment="Center" Foreground="{DynamicResource TextSecondary}" />
                    <ComboBox Name="TargetLangCombo" Width="88" DisplayMemberPath="NameZh" SelectionChanged="Language_Changed" />
                    <TextBlock Name="RegionText" Style="{StaticResource CaptionText}" Margin="10,0,0,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                </StackPanel>
                <Button Content="复制译文" Style="{StaticResource GhostButton}" HorizontalAlignment="Right" Padding="6,1" Click="Copy_Click" />
            </Grid>

            <Border Grid.Row="2"
                    Margin="14,4,14,0"
                    Background="{DynamicResource InputBg}"
                    BorderBrush="{DynamicResource Border}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="10">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock Text="识别原文" FontWeight="SemiBold" FontSize="12" />
                    <TextBox Name="SourceBox"
                             Grid.Row="1"
                             Margin="0,5,0,0"
                             MinHeight="50"
                             MaxHeight="120"
                             IsReadOnly="True"
                             AcceptsReturn="True"
                             TextWrapping="Wrap"
                             VerticalScrollBarVisibility="Auto"
                             BorderThickness="0"
                             Background="Transparent"
                             FontFamily="Microsoft YaHei UI"
                             FontSize="13" />
                </Grid>
            </Border>

            <Border Grid.Row="3"
                    Margin="14,8,14,0"
                    Background="{DynamicResource InputBg}"
                    BorderBrush="{DynamicResource Border}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="10">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock Text="实时译文" FontWeight="SemiBold" FontSize="12" />
                    <TextBox Name="OutputBox"
                             Grid.Row="1"
                             Margin="0,5,0,0"
                             MinHeight="80"
                             MaxHeight="260"
                             IsReadOnly="True"
                             AcceptsReturn="True"
                             TextWrapping="Wrap"
                             VerticalScrollBarVisibility="Auto"
                             BorderThickness="0"
                             Background="Transparent"
                             FontFamily="Microsoft YaHei UI"
                             FontSize="15" />
                </Grid>
            </Border>

            <Grid Grid.Row="4" Margin="16,8,16,12">
                <TextBlock Name="StatusText" Style="{StaticResource CaptionText}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                <Button Content="关闭" Style="{StaticResource GhostButton}" HorizontalAlignment="Right" Click="Close_Click" />
            </Grid>
        </Grid>
    </Border>
</Window>
