<?xml version="1.0" encoding="utf-8"?>
<Window x:Class="KuangYi.App.Windows.PinImageWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="框译 · 贴图"
        Icon="/Assets/app.ico"
        Width="420"
        Height="300"
        MinWidth="180"
        MinHeight="100"
        WindowStyle="None"
        ResizeMode="CanResizeWithGrip"
        ShowInTaskbar="False"
        Topmost="True"
        AllowsTransparency="True"
        Background="#00FFFFFF"
        UseLayoutRounding="True">
    <Border Margin="10"
            Background="{DynamicResource CardBg}"
            BorderBrush="{DynamicResource Border}"
            BorderThickness="1"
            CornerRadius="8"
            MouseLeftButtonDown="Border_MouseLeftButtonDown">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Image Name="PreviewImage" Stretch="Uniform" Margin="8" />
            <Grid Grid.Row="1" Margin="8,0,8,8">
                <TextBlock Text="拖动移动 · 拖右下角缩放" Style="{StaticResource CaptionText}" VerticalAlignment="Center" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="复制图片" Style="{StaticResource GhostButton}" Click="Copy_Click" />
                    <Button Content="关闭" Style="{StaticResource GhostButton}" Click="Close_Click" />
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</Window>
