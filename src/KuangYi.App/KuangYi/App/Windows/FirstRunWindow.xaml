<?xml version="1.0" encoding="utf-8"?>
<Window x:Class="KuangYi.App.Windows.FirstRunWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="框译 · 首次使用"
        Icon="/Assets/app.ico"
        Width="520"
        SizeToContent="Height"
        WindowStyle="None"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterScreen"
        AllowsTransparency="True"
        Background="#00FFFFFF"
        UseLayoutRounding="True">
    <Window.Resources>
        <Style x:Key="CardTitle" TargetType="TextBlock" BasedOn="{StaticResource SectionTitle}">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Margin" Value="0,0,0,8" />
        </Style>
    </Window.Resources>
    <Border Margin="14"
            Background="{DynamicResource CardBg}"
            BorderBrush="{DynamicResource Border}"
            BorderThickness="1"
            CornerRadius="12">
        <UIElement.Effect>
            <DropShadowEffect BlurRadius="20" ShadowDepth="2" Opacity="0.25" Color="Black" />
        </UIElement.Effect>
        <StackPanel Margin="24,18,24,18">
            <Grid MouseLeftButtonDown="Header_MouseLeftButtonDown">
                <StackPanel>
                    <TextBlock Text="欢迎使用框译" Style="{StaticResource SectionTitle}" />
                    <TextBlock Text="按 F2 框选屏幕，识别后直接翻译" Style="{StaticResource CaptionText}" Margin="0,3,0,0" />
                </StackPanel>
                <Button Content="✕" Style="{StaticResource GhostButton}" HorizontalAlignment="Right" Click="Cancel_Click" />
            </Grid>

            <Border Height="1" Background="{DynamicResource Border}" Margin="0,14" />

            <TextBlock Text="默认翻译方向" Style="{StaticResource CardTitle}" />
            <Grid Margin="0,6,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <StackPanel Margin="0,0,8,0">
                    <TextBlock Text="源语言" Style="{StaticResource CaptionText}" Margin="0,0,0,4" />
                    <ComboBox Name="SourceLangCombo" DisplayMemberPath="NameZh" />
                </StackPanel>
                <StackPanel Grid.Column="1">
                    <TextBlock Text="目标语言" Style="{StaticResource CaptionText}" Margin="0,0,0,4" />
                    <ComboBox Name="TargetLangCombo" DisplayMemberPath="NameZh" />
                </StackPanel>
            </Grid>

            <TextBlock Text="全局热键" Style="{StaticResource CardTitle}" Margin="0,14,0,0" />
            <TextBox Name="HotkeyBox" IsReadOnly="True" Margin="0,6,0,0" PreviewKeyDown="HotkeyBox_PreviewKeyDown" />

            <CheckBox Name="StartupCheck" Content="开机自动启动（当前用户）" Margin="0,12,0,0" />

            <Border Background="{DynamicResource InputBg}"
                    BorderBrush="{DynamicResource Border}"
                    BorderThickness="1"
                    CornerRadius="6"
                    Padding="10,8"
                    Margin="0,12,0,0">
                <TextBlock Name="ModelStatusText" Style="{StaticResource CaptionText}" TextWrapping="Wrap" />
            </Border>

            <TextBlock Text="这些设置随时可以在托盘菜单 → 设置中修改。"
                       Style="{StaticResource CaptionText}"
                       TextWrapping="Wrap"
                       Margin="0,10,0,0" />

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
                <Button Content="稍后设置" Style="{StaticResource GhostButton}" Margin="0,0,8,0" Click="Cancel_Click" />
                <Button Content="开始使用" Style="{StaticResource PrimaryButton}" Padding="18,7" Click="Start_Click" />
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
