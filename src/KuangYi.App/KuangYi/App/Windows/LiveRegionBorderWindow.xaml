<?xml version="1.0" encoding="utf-8"?>
<Window x:Class="KuangYi.App.Windows.LiveRegionBorderWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="框译 · 实时翻译"
        Width="200"
        Height="200"
        WindowStyle="None"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        ShowActivated="False"
        Focusable="False"
        IsHitTestVisible="False"
        Topmost="True"
        AllowsTransparency="True"
        Background="Transparent"
        UseLayoutRounding="True">
    <Grid>
        <Border BorderBrush="{DynamicResource Accent}"
                BorderThickness="2"
                CornerRadius="4"
                Margin="0,26,0,0"
                Background="#121F6FEB" />
        <Border Background="#E61F6FEB"
                CornerRadius="4"
                HorizontalAlignment="Left"
                VerticalAlignment="Top"
                Margin="0,2,0,0"
                Padding="8,3">
            <TextBlock Text="实时翻译区域"
                       Foreground="White"
                       FontSize="11"
                       FontWeight="SemiBold" />
        </Border>
    </Grid>
</Window>
