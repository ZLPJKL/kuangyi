<?xml version="1.0" encoding="utf-8"?>
<Window x:Class="KuangYi.App.Windows.StartupNoticeWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:windows="clr-namespace:KuangYi.App.Windows;assembly=KuangYi" Title="框译" Icon="/Assets/app.ico" Width="420" SizeToContent="Height" WindowStyle="None" ResizeMode="NoResize" ShowInTaskbar="False" WindowStartupLocation="Manual" AllowsTransparency="True" Background="#00FFFFFF" Topmost="True" UseLayoutRounding="True">
  <Border Margin="12" Background="{DynamicResource CardBg}" BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="12">
    <UIElement.Effect>
      <DropShadowEffect BlurRadius="18" ShadowDepth="2" Opacity="0.25" Color="Black" />
    </UIElement.Effect>
    <StackPanel Margin="18,14,18,14">
      <TextBlock Name="TitleText" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" />
      <TextBlock Name="BodyText" Margin="0,8,0,0" TextWrapping="Wrap" LineHeight="20" Foreground="{DynamicResource TextSecondary}" />
      <Button Content="知道了" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Right" Padding="16,5" Margin="0,14,0,0" Click="Close_Click" />
    </StackPanel>
  </Border>
</Window>