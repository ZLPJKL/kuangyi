<?xml version="1.0" encoding="utf-8"?>
<Window x:Class="KuangYi.App.Windows.BatchWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="框译 · 批量翻译"
        Icon="/Assets/app.ico"
        Width="820"
        Height="600"
        WindowStyle="None"
        ResizeMode="CanResizeWithGrip"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterScreen"
        AllowsTransparency="True"
        Background="#00FFFFFF"
        UseLayoutRounding="True">
    <Border Margin="14"
            Background="{DynamicResource CardBg}"
            BorderBrush="{DynamicResource Border}"
            BorderThickness="1"
            CornerRadius="12">
        <Grid Margin="18,14,18,16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" MouseLeftButtonDown="Header_MouseLeftButtonDown">
                <StackPanel>
                    <TextBlock Text="批量翻译" Style="{StaticResource SectionTitle}" />
                    <TextBlock Text="支持多张图片和 PDF 逐页识别，结果可导出 CSV。" Style="{StaticResource CaptionText}" Margin="0,2,0,0" />
                </StackPanel>
                <Button Content="✕" Style="{StaticResource GhostButton}" HorizontalAlignment="Right" Click="Close_Click" />
            </Grid>

            <WrapPanel Grid.Row="1" Margin="0,12,0,8">
                <Button Content="选择图片 / PDF" Style="{StaticResource GhostButton}" Margin="0,0,6,4" Click="OpenFiles_Click" />
                <Button Name="StartButton" Content="开始翻译" Style="{StaticResource PrimaryButton}" Padding="14,5" Margin="0,0,6,4" Click="Start_Click" />
                <Button Content="导出 CSV" Style="{StaticResource GhostButton}" Margin="0,0,6,4" Click="Export_Click" />
                <Button Content="清空列表" Style="{StaticResource GhostButton}" Margin="0,0,6,4" Click="Clear_Click" />
            </WrapPanel>

            <DataGrid Name="ItemsGrid"
                      Grid.Row="2"
                      AutoGenerateColumns="False"
                      CanUserAddRows="False"
                      IsReadOnly="True"
                      HeadersVisibility="Column"
                      GridLinesVisibility="Horizontal"
                      RowHeaderWidth="0"
                      Background="{DynamicResource InputBg}"
                      BorderBrush="{DynamicResource Border}"
                      BorderThickness="1">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="文件" Binding="{Binding Path}" Width="2*" />
                    <DataGridTextColumn Header="状态" Binding="{Binding Status}" Width="1.2*" />
                    <DataGridTextColumn Header="原文" Binding="{Binding SourceText}" Width="2*" />
                    <DataGridTextColumn Header="译文" Binding="{Binding Translation}" Width="2*" />
                </DataGrid.Columns>
            </DataGrid>

            <Grid Grid.Row="3" Margin="0,10,0,0">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <ProgressBar Name="Progress" Width="180" Height="6" />
                    <TextBlock Name="StatusText" Style="{StaticResource CaptionText}" Margin="8,0,0,0" VerticalAlignment="Center" />
                </StackPanel>
                <Button Content="关闭" Style="{StaticResource GhostButton}" HorizontalAlignment="Right" Click="Close_Click" />
            </Grid>
        </Grid>
    </Border>
</Window>
