<?xml version="1.0" encoding="utf-8"?>
<Window x:Class="KuangYi.App.Windows.ModelDownloadWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="框译 · 下载离线语言包"
        Icon="/Assets/app.ico"
        Width="560"
        SizeToContent="Height"
        WindowStyle="None"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        AllowsTransparency="True"
        Background="#00FFFFFF"
        UseLayoutRounding="True">
    <Border Margin="14"
            Background="{DynamicResource CardBg}"
            BorderBrush="{DynamicResource Border}"
            BorderThickness="1"
            CornerRadius="12">
        <StackPanel Margin="22,16,22,18">
            <Grid MouseLeftButtonDown="Header_MouseLeftButtonDown">
                <TextBlock Text="下载离线语言包" Style="{StaticResource SectionTitle}" />
                <Button Content="✕" Style="{StaticResource GhostButton}" HorizontalAlignment="Right" Click="Close_Click" />
            </Grid>
            <TextBlock Text="语言包约 1.2 GB，下载完成后会自动校验并解压到本机数据目录。断点续传由系统网络堆栈处理。"
                       Style="{StaticResource CaptionText}" TextWrapping="Wrap" Margin="0,8,0,0" />
            <ProgressBar Name="Progress" Height="8" Margin="0,16,0,0" Minimum="0" Maximum="100" />
            <TextBlock Name="StatusText" Style="{StaticResource CaptionText}" TextWrapping="Wrap" Margin="0,8,0,0" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
                <Button Name="OpenFolderButton" Content="打开数据目录" Style="{StaticResource GhostButton}" Visibility="Collapsed" Click="OpenFolder_Click" />
                <Button Name="StartButton" Content="开始下载" Style="{StaticResource PrimaryButton}" Padding="16,6" Click="Start_Click" />
                <Button Name="CancelButton" Content="取消" Style="{StaticResource GhostButton}" Margin="8,0,0,0" Visibility="Collapsed" Click="Cancel_Click" />
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
