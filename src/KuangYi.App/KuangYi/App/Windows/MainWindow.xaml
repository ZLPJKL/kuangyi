<?xml version="1.0" encoding="utf-8"?>
<Window x:Class="KuangYi.App.Windows.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:windows="clr-namespace:KuangYi.App.Windows;assembly=KuangYi" Title="框译" Icon="/Assets/app.ico" Width="380" SizeToContent="Height" WindowStyle="None" ResizeMode="NoResize" ShowInTaskbar="False" WindowStartupLocation="CenterScreen" AllowsTransparency="True" Background="#00FFFFFF" UseLayoutRounding="True" KeyDown="Window_KeyDown">
  <Border Margin="14" Background="{DynamicResource CardBg}" BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="12">
    <UIElement.Effect>
      <DropShadowEffect BlurRadius="20" ShadowDepth="2" Opacity="0.25" Color="Black" />
    </UIElement.Effect>
    <Grid Margin="20,14,20,16">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>
      <Grid Row="0" Margin="0,0,0,8" MouseLeftButtonDown="Header_MouseLeftButtonDown">
        <TextBlock Text="框译" Style="{StaticResource SectionTitle}" VerticalAlignment="Center" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
          <Button Content="—" Style="{StaticResource GhostButton}" Padding="10,1" ToolTip="最小化到托盘" Click="Minimize_Click" />
          <Button Content="✕" Style="{StaticResource GhostButton}" Padding="10,1" ToolTip="退出框译" Click="Close_Click" />
        </StackPanel>
      </Grid>
      <TextBlock Grid.Row="1" Text="按 F2 框选屏幕区域，或点击下方按钮。" Foreground="{DynamicResource TextSecondary}" TextWrapping="Wrap" />
      <Button Grid.Row="2" Content="框选翻译 (F2)" Style="{StaticResource PrimaryButton}" Padding="18,10" Margin="0,16,0,0" Click="Capture_Click" />
      <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,10,0,0">
        <Button Content="剪贴板识别" Style="{StaticResource GhostButton}" ToolTip="识别剪贴板里的图片（Ctrl+V）" Click="Clipboard_Click" />
        <Button Content="图片识别" Style="{StaticResource GhostButton}" ToolTip="选择一张图片文件进行识别" Click="ImageFile_Click" />
      </StackPanel>
      <Grid Row="4" Margin="0,10,0,0">
        <StackPanel Orientation="Horizontal">
          <Button Content="设置" Style="{StaticResource GhostButton}" Click="Settings_Click" />
          <Button Content="结果" Style="{StaticResource GhostButton}" Click="Result_Click" />
          <Button Content="历史" Style="{StaticResource GhostButton}" Click="History_Click" />
        </StackPanel>
        <Button Content="退出" Style="{StaticResource GhostButton}" Foreground="{DynamicResource Danger}" HorizontalAlignment="Right" Click="Exit_Click" />
      </Grid>
    </Grid>
  </Border>
</Window>